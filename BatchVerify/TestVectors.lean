import BatchVerify.Secp256k1
import BatchVerify.BIP340
import BatchVerify.SHA256

/-!
# The BIP340 test vectors

Runs the official BIP340 test vectors (`bip-0340/test-vectors.csv`) against
the model: `BIP340.pubkey`, `BIP340.sign` and `BIP340.verify` on `secp256k1`,
with the tagged hashes of BIP340 as `challenge` and `nonce`.

Mathlib's group law is too slow to evaluate directly on 256-bit scalars
and square roots, so `verifyFast`, `signFast` and `pubkeyFast` use
double-and-add and `Nat.powMod`, and are **proven equal** to the model's
definitions (`verify_eq`, `sign_eq`, `pubkey_eq`). The `#guard`s therefore
test the definitions the theorems are about. They run compiled code, but no
proof depends on them.

Byte decoding is outside the model (scalars live in `ZMod n`, coordinates in
`𝔽_p`), so the range checks `pk < p`, `r < p` and `s < n` are done here.
-/

set_option linter.style.longLine false
set_option linter.hashCommand false

namespace BatchVerify.TestVectors

open Secp256k1 BIP340 SHA256

/-! ## The BIP340 hashes -/

/-- `e = int(hash_BIP0340/challenge(bytes(r) ‖ bytes(P) ‖ m)) mod n`. -/
def challenge (r pk : F) (m : ByteArray) : ZMod n :=
  (SHA256.toNat (taggedHash "BIP0340/challenge" (bytes32 r.val ++ bytes32 pk.val ++ m)) : ZMod n)

/-- BIP340 nonce derivation with auxiliary randomness `a`:
`k' = int(hash_BIP0340/nonce(t ‖ bytes(P) ‖ m)) mod n`, where
`t = bytes(d) xor hash_BIP0340/aux(a)`. -/
def nonce (a : ByteArray) (d : ZMod n) (px : F) (m : ByteArray) : ZMod n :=
  let t := ByteArray.mk ((bytes32 d.val).data.zipWith (· ^^^ ·) (taggedHash "BIP0340/aux" a).data)
  (SHA256.toNat (taggedHash "BIP0340/nonce" (t ++ bytes32 px.val ++ m)) : ZMod n)

/-! ## Fast versions, proven equal to the model -/

/-- Double-and-add scalar multiplication. -/
def smulDA {A : Type*} [AddMonoid A] (k : ℕ) (P : A) : A :=
  if k = 0 then 0 else
  let Q := smulDA (k / 2) (P + P)
  if k % 2 = 0 then Q else Q + P
termination_by k
decreasing_by omega

theorem smulDA_eq {A : Type*} [AddMonoid A] (k : ℕ) (P : A) : smulDA k P = k • P := by
  induction k using Nat.strong_induction_on generalizing P with
  | _ k ih =>
    rw [smulDA]
    split_ifs with h0 h2
    · simp [h0]
    · rw [ih _ (by omega), ← two_nsmul, ← mul_nsmul', show k / 2 * 2 = k by omega]
    · rw [ih _ (by omega), ← two_nsmul, ← mul_nsmul', ← succ_nsmul,
        show k / 2 * 2 + 1 = k by omega]

/-- `lift_x` with the square root computed by `Nat.powMod`. -/
def liftXFast (x : F) : Option Point :=
  let y : F := ((Pratt.powMod (x ^ 3 + 7).val ((p + 1) / 4) p : ℕ) : F)
  if h : y ^ 2 = x ^ 3 + 7 then
    some (.some x (evenRoot y) ((nonsingular_iff _ _).mpr (by rw [evenRoot_sq, h])))
  else none

theorem liftX_eq (x : F) : liftX x = liftXFast x := by
  have hy : (x ^ 3 + 7) ^ sqrtExp = ((Pratt.powMod (x ^ 3 + 7).val ((p + 1) / 4) p : ℕ) : F) := by
    rw [sqrtExp_def, ← Pratt.natCast_pow_eq_powMod _ _ _ (by decide +kernel), ZMod.natCast_zmod_val]
  unfold liftX liftXFast
  simp only [hy]

def verifyFast (pk : F) (m : ByteArray) (sig : F × ZMod n) : Bool :=
  match liftXFast pk with
  | none => false
  | some P =>
    let R := smulDA sig.2.val G - smulDA (challenge sig.1 pk m).val P
    decide (R ≠ 0) && hasEvenY R && decide (xCoord R = sig.1)

theorem verify_eq (pk : F) (m : ByteArray) (sig : F × ZMod n) :
    verify secp256k1 challenge pk m sig = verifyFast pk m sig := by
  obtain ⟨r, s⟩ := sig
  have hl : secp256k1.liftX pk = liftXFast pk := liftX_eq pk
  unfold verify verifyFast
  rw [hl]
  cases liftXFast pk <;> simp [Curve.mulG_eq_val_smul, smulDA_eq, secp256k1]

def pubkeyFast (sk : ZMod n) : Option F :=
  if sk = 0 then none else some (xCoord (smulDA sk.val G))

theorem pubkey_eq (sk : ZMod n) : pubkey secp256k1 sk = pubkeyFast sk := by
  simp [pubkey, pubkeyFast, Curve.mulG_eq_val_smul, smulDA_eq, secp256k1]

def signFast (a : ByteArray) (sk : ZMod n) (m : ByteArray) : Option (F × ZMod n) :=
  if sk = 0 then none else
  let P := smulDA sk.val G
  let d := if hasEvenY P then sk else -sk
  let k₀ := nonce a d (xCoord P) m
  if k₀ = 0 then none else
  let R := smulDA k₀.val G
  let k := if hasEvenY R then k₀ else -k₀
  some (xCoord R, k + challenge (xCoord R) (xCoord P) m * d)

theorem sign_eq (a : ByteArray) (sk : ZMod n) (m : ByteArray) :
    sign secp256k1 challenge (nonce a) sk m = signFast a sk m := by
  simp [sign, signFast, Curve.evenScalar, Curve.mulG_eq_val_smul, smulDA_eq, secp256k1]

/-! ## Running the vectors -/

/-- One row of `bip-0340/test-vectors.csv`. -/
structure Vector where
  index : ℕ
  sk : String
  pk : String
  aux : String
  msg : String
  sig : String
  result : Bool

/-- `Verify` on bytes: the range checks of BIP340, then the model's `verify`. -/
def verifyBytes (pk m sig : ByteArray) : Bool :=
  let x := SHA256.toNat pk
  let r := SHA256.toNat (sig.extract 0 32)
  let s := SHA256.toNat (sig.extract 32 64)
  x < p && r < p && s < n && verifyFast (x : F) m ((r : F), (s : ZMod n))

/-- A vector passes if verification gives the expected result and, when a
secret key is given, `pubkey` and `sign` reproduce the public key and signature. -/
def Vector.check (v : Vector) : Bool :=
  let m := ofHex v.msg
  verifyBytes (ofHex v.pk) m (ofHex v.sig) == v.result &&
  (v.sk.isEmpty ||
    let sk : ZMod n := (SHA256.toNat (ofHex v.sk) : ZMod n)
    (pubkeyFast sk).map (bytes32 ·.val) == some (ofHex v.pk) &&
    (signFast (ofHex v.aux) sk m).map (fun sg => bytes32 sg.1.val ++ bytes32 sg.2.val) ==
      some (ofHex v.sig))

